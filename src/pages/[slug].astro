---
import { render } from "astro:content"
import Base from "../layouts/Base.astro"
import TableOfContents from "../components/TableOfContents.astro"
import { getPostsNewestFirst } from "../lib/posts"
import { extractFaqs } from "../lib/faqs"
import { formatDate } from "../lib/site"

export const getStaticPaths = async () => {
  const posts = await getPostsNewestFirst()
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { title, date, modified, excerpt } = post.data
const { Content, headings } = await render(post)
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3)

if (!post.rendered) throw new Error(`Post ${post.id} has no rendered HTML`)
const faqs = extractFaqs(post.rendered.html)
const description = `Explore ${title} and discover insights, tips, and tools to help you succeed. Dive into the full guide now!`
---

<Base
  title={title}
  description={description}
  pathname={`/${post.id}/`}
  article={true}
  datePublished={date}
  dateModified={modified}
  faqs={faqs}
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Blog", item: "/blog/" },
    { name: title, item: `/${post.id}/` },
  ]}
>
  <div class="post">
    <div class="py-8">
      <div class="text-[13px] text-faint mb-2">{formatDate(date, "long")}</div>
      <h1 class="text-3xl md:text-4xl font-semibold tracking-tight text-fg leading-tight">
        {title}
      </h1>
    </div>

    <!-- GEO Optimized: lead / summary -->
    <div class="border-l-2 border-line pl-4 mb-12 text-[15px] italic text-muted">
      {excerpt.slice(0, 160)}...
    </div>

    <div class="text-[16px] text-muted leading-relaxed">
      <Content />
    </div>

    <div class="mt-16 pt-8 border-t border-line">
      <div class="giscus"></div>
      <script
        is:inline
        src="https://giscus.app/client.js"
        data-repo="maxlibin/maxlibin.com"
        data-repo-id="MDEwOlJlcG9zaXRvcnkxNzQ3MTQ5MTg="
        data-category="General"
        data-category-id="DIC_kwDOCmnwJs4CTNwO"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="preferred_color_scheme"
        data-lang="en"
        crossorigin="anonymous"
        async
      ></script>
    </div>
  </div>

  {tocHeadings.length > 0 && <TableOfContents headings={tocHeadings} />}
</Base>
