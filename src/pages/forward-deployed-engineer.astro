    { name: "Home", item: "/" },
    {
      name: "Forward-Deployed Engineer",
      item: "/forward-deployed-engineer/",
    },
  ]}
>
  <article class="mt-4">
    <header class="pb-10 border-b border-line">
      <p class="text-[13px] font-medium uppercase tracking-wider text-faint mb-4">
        Forward-Deployed Engineer
      </p>
      <h1 class="text-3xl md:text-4xl font-semibold tracking-tight text-fg leading-tight">
        Turning difficult customer problems into software that works.
      </h1>
      <p class="mt-5 text-[16px] leading-relaxed text-muted">
        I’m Max Li, an AI engineer and product builder based in Singapore. I
        bring 16+ years of engineering experience—including 12 years scaling
        Ahrefs’ frontend—and a hands-on approach to taking products from an
        ambiguous idea to a deployed application.
      </p>
      <p class="mt-4 text-[15px] leading-relaxed text-muted">
        I’m interested in forward-deployed engineering roles where I can work
        directly with customers, understand their operations, and build the
        right solution alongside them.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href="mailto:me@maxlibin.com?subject=Forward-Deployed%20Engineer"
          class="inline-flex items-center rounded-lg bg-fg px-4 py-2.5 text-[14px] font-medium text-bg hover:opacity-85 transition-opacity"
        >
          Start a conversation
        </a>
        <a
          href="https://linkedin.com/in/maxlibin"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center rounded-lg border border-line bg-surface px-4 py-2.5 text-[14px] font-medium text-fg hover:border-faint transition-colors"
        >
          LinkedIn ↗
        </a>
      </div>
    </header>

    <section class="py-10 border-b border-line">
      <h2 class="text-xl font-semibold text-fg mb-6">What I bring</h2>
      <div class="grid sm:grid-cols-2 gap-x-8 gap-y-7">
        {strengths.map((strength) => (
          <div>
            <h3 class="text-[15px] font-medium text-fg mb-1.5">
              {strength.title}
            </h3>
            <p class="text-[14px] leading-relaxed text-muted">
              {strength.description}
            </p>
          </div>
        ))}
      </div>
    </section>

    <section class="py-10 border-b border-line">
      <h2 class="text-xl font-semibold text-fg mb-2">How I would work</h2>
      <p class="text-[14px] leading-relaxed text-muted mb-7">
        Forward-deployed work starts with the outcome, not the technology.
      </p>
      <div>
        {process.map((step) => (
          <div class="grid grid-cols-[2.5rem_1fr] gap-3 py-5 border-t border-line first:border-t-0 first:pt-0">
            <span class="text-[12px] font-medium text-faint pt-0.5">
              {step.number}
            </span>
            <div>
              <h3 class="text-[15px] font-medium text-fg mb-1">{step.title}</h3>
              <p class="text-[14px] leading-relaxed text-muted">
                {step.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="py-10 border-b border-line">
      <h2 class="text-xl font-semibold text-fg mb-2">Representative work</h2>
      <p class="text-[14px] leading-relaxed text-muted mb-7">
        Products I have shipped across AI, web, and mobile.
      </p>
      <div class="space-y-6">
        {projects.map((project) => (
          <div>
            <div class="flex flex-wrap items-baseline gap-x-2 mb-1.5">
              <h3 class="text-[15px] font-medium text-fg">
                <a
                  href={project.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-muted transition-colors"
                >
                  {project.title} <span class="text-faint">↗</span>
                </a>
              </h3>
              <span class="text-[12px] text-faint">{project.type}</span>
            </div>
            <p class="text-[14px] leading-relaxed text-muted">
              {project.description}
