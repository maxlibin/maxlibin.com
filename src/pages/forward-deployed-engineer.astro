<Base
  title="Forward-Deployed Engineer | Max Li"
  description="Max Li is a hands-on AI engineer in Singapore who turns complex customer problems into practical, production-ready software."
  keywords="forward deployed engineer, FDE, AI engineer, customer engineering, product engineer, Singapore, Max Li"
  pathname="/forward-deployed-engineer/"
