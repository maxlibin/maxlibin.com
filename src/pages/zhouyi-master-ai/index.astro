---
import { Image } from "astro:assets"
import Base from "../../layouts/Base.astro"
import emblem from "../../assets/zhouyi-master-ai.png"

const APP_STORE_URL = "https://apps.apple.com/app/id6815581151"
const CONTACT_EMAIL = "me@maxlibin.com"

const pages = [
  {
    href: "/zhouyi-master-ai/privacy/",
    title: "Privacy Policy",
    blurb: "What stays on your iPhone, what is sent, and who processes it.",
  },
  {
    href: "/zhouyi-master-ai/terms/",
    title: "Terms of Use",
    blurb: "The subscription, fair use, and what the replies are and aren't.",
  },
  {
    href: "/zhouyi-master-ai/support/",
    title: "Support",
    blurb: "Get help, ask a question, report a bug.",
  },
]
---

<Base
  wide
  title="ZhouYi Master AI — I Ching readings & reflection for iPhone"
  description="Toss three coins by flicking your iPhone, read your hexagram from the Book of Changes, and reflect on it with Yi Master, an AI guide."
  pathname="/zhouyi-master-ai/"
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "ZhouYi Master AI", item: "/zhouyi-master-ai/" },
  ]}
  softwareApp={{
    name: "ZhouYi Master AI",
    description:
      "I Ching (Yijing) readings and reflection for iPhone — cast coins, read the Book of Changes, and talk it through with Yi Master.",
    applicationCategory: "LifestyleApplication",
    operatingSystem: "iOS",
    url: APP_STORE_URL,
  }}
>
  <div class="mt-8 mb-16 px-4 md:px-0">
    <div class="py-10 border-b border-line mb-10">
      <div class="flex flex-col md:flex-row md:items-center gap-8">
        <div class="flex-1">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-xs font-bold uppercase tracking-widest text-fg">
              iOS app
            </span>
            <span class="text-xs font-bold uppercase tracking-widest text-faint">
              周易 · Book of Changes
            </span>
          </div>
          <h1 class="text-3xl md:text-4xl font-semibold tracking-tight text-fg mb-4">
            ZhouYi Master AI
          </h1>
          <p class="text-xl text-muted max-w-2xl mb-6">
            Toss three coins with a flick of your iPhone, read your hexagram
            from the Book of Changes, and reflect on it with Yi Master.
            Reflection, not prediction.
          </p>
          <a
            href={APP_STORE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 border border-transparent text-base font-medium rounded-xl shadow-sm text-bg bg-fg hover:opacity-90 transition-all hover:scale-[1.02]"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 384 512"
              class="w-5 h-5 fill-current"
            >
              <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"></path>
            </svg>
            Download on the App Store
          </a>
        </div>
        <div class="flex-shrink-0 flex justify-center md:justify-end">
          <Image
            src={emblem}
            alt="ZhouYi Master AI emblem: a yin-yang painted as waves and clouds"
            width={512}
            class="w-48 h-48 md:w-64 md:h-64 object-contain drop-shadow-xl"
            loading="eager"
          />
        </div>
      </div>
    </div>

    <section class="mb-12">
      <h2 class="text-2xl font-bold text-fg mb-4">What it does</h2>
      <ul class="space-y-3 text-muted max-w-2xl">
        <li>
          🪙 Toss three coins by flicking your phone; real physics, no dice
          rolls.
        </li>
        <li>
          📖 Read all 64 hexagrams: traditional text, changing lines,
          reflection.
        </li>
        <li>
          💬 Talk a reading through with Yi Master, an AI guide that reflects,
          not predicts.
        </li>
        <li>
          🗓️ Keep a journal of your readings and a daily pause for reflection.
        </li>
        <li>
          🔒 No account, no ads, no trackers; your journal stays on your iPhone.
        </li>
      </ul>
    </section>

    <section>
      <h2 class="text-2xl font-bold text-fg mb-6">Information</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-3xl">
        {pages.map(({ href, title, blurb }) => (
          <a
            href={href}
            class="block p-5 rounded-xl border border-line bg-surface hover:shadow-lg hover:-translate-y-0.5 transition-all"
          >
            <h3 class="font-bold text-fg mb-1">{title}</h3>
            <p class="text-sm text-muted">{blurb}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-12 p-6 bg-surface rounded-2xl border border-line">
      <p class="text-muted">
        Questions, feedback, or bug reports? Email{" "}
        <a
          href={`mailto:${CONTACT_EMAIL}`}
          class="text-fg hover:underline font-semibold"
        >
          {CONTACT_EMAIL}
        </a>
        .
      </p>
    </section>
  </div>
</Base>
