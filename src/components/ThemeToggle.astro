---
// Toggles the class-based theme set up by the inline script in Base.astro.
// Both icons are rendered; CSS shows the one matching the current theme.
---

<button
  type="button"
  id="theme-toggle"
  aria-label="Color Mode"
  class="flex justify-center p-2 text-faint hover:text-fg transition-colors rounded-md focus:outline-none"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 20 20"
    fill="currentColor"
    class="w-5 h-5 transform -rotate-90 hidden dark:block"
    aria-hidden="true"
  >
    <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
  </svg>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 20 20"
    fill="currentColor"
    class="w-5 h-5 block dark:hidden"
    aria-hidden="true"
  >
    <path
      d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
      fill-rule="evenodd"
      clip-rule="evenodd"
    ></path>
  </svg>
</button>

<script>
  declare global {
    interface Window {
      __theme: "light" | "dark"
      __setPreferredTheme: (theme: "light" | "dark") => void
    }
  }

  const button = document.getElementById("theme-toggle")
  if (!button) throw new Error("ThemeToggle: #theme-toggle not found")
  button.addEventListener("click", () => {
    window.__setPreferredTheme(window.__theme === "dark" ? "light" : "dark")
  })
</script>
