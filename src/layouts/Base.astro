---
import "../styles/global.css"
import Header from "../components/Header.astro"
import { site } from "../lib/site"
import { resolveSeo, type SeoProps } from "../lib/seo"

type Props = SeoProps & { wide?: boolean }

const { wide, ...seoProps } = Astro.props
const seo = resolveSeo(seoProps)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="keywords" content={seo.keywords} />
    <meta name="image" content={seo.image} />

    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={seo.image} />
    <meta property="og:url" content={seo.url} />
    <meta property="og:type" content={seo.article ? "article" : "website"} />
    <meta property="og:site_name" content={site.title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:url" content={seo.url} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.image} />
    <meta name="twitter:creator" content={site.twitterUsername} />

    <link rel="canonical" href={seo.url} />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#111111" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {seo.jsonLd.map((schema) => (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(schema)}
      ></script>
    ))}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />

    <!-- Theme bootstrap: runs before paint so there is no light/dark flash. -->
    <script is:inline>
      ;(function () {
        function setTheme(theme) {
          window.__theme = theme
          document.documentElement.className = theme === "dark" ? "dark" : ""
        }
        window.__setPreferredTheme = function (theme) {
          setTheme(theme)
          try {
            localStorage.setItem("color-theme", theme)
          } catch (e) {}
        }
        var preferredTheme
        try {
          preferredTheme = localStorage.getItem("color-theme")
        } catch (e) {}
        var darkQuery = window.matchMedia("(prefers-color-scheme: dark)")
        setTheme(preferredTheme || (darkQuery.matches ? "dark" : "light"))
      })()
    </script>
    <!-- Time-of-day favicon (Singapore time). Same thresholds as src/lib/timeEmoji.ts. -->
    <script is:inline>
      ;(function () {
        try {
          var h =
            parseInt(
              new Intl.DateTimeFormat("en-US", {
                timeZone: "Asia/Singapore",
                hour: "numeric",
                hour12: false,
              }).format(new Date()),
              10
            ) % 24
          var e =
            h >= 6 && h < 12
              ? "🟢"
              : h >= 12 && h < 18
                ? "🧑‍💻"
                : h >= 18 && h < 22
                  ? "😌"
                  : "😴"
          var svg =
            "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>" +
            e +
            "</text></svg>"
          var link = document.querySelector("link[rel~='icon']")
          link.setAttribute(
            "href",
            "data:image/svg+xml," + encodeURIComponent(svg)
          )
        } catch (err) {}
      })()
    </script>
    <script
      is:inline
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${site.gaTrackingId}`}
    ></script>
    <script is:inline define:vars={{ id: site.gaTrackingId }}>
      window.dataLayer = window.dataLayer || []
      function gtag() {
        dataLayer.push(arguments)
      }
      gtag("js", new Date())
      gtag("config", id, { anonymize_ip: true })
    </script>
    <slot name="head" />
  </head>
  <body class="bg-bg">
    <div class="min-h-full bg-bg text-muted px-6">
      <div
        class:list={[
          "mx-auto flex flex-col min-h-full",
          wide ? "max-w-5xl" : "max-w-content",
        ]}
      >
        <Header />
        <main class="pb-24">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
